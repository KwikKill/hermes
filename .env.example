# Copy to .env and fill in real values. Read by both the `hermes` app
# container and the `hermes-cron` sidecar (see ../site-compose.yml).

# YouTube Data API v3 key - used for the channel search field (100 quota
# units/search) and, during polling, to check each newly-found video's
# duration so Shorts can be filtered out (1 unit per poll per channel,
# regardless of how many videos - cheap). Create one at
# https://console.cloud.google.com/apis/credentials after enabling
# "YouTube Data API v3" on a project. Free tier: 10,000 units/day.
YOUTUBE_API_KEY=

# RAWG API key - used for both game search and polling release dates.
# Free signup at https://rawg.io/apidocs, generous free tier.
RAWG_API_KEY=

# Shared secret the hermes-cron sidecar sends as `Authorization: Bearer` to
# POST /api/poll. Generate with: openssl rand -hex 32
HERMES_POLL_SECRET=
